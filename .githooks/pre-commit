#!/bin/sh
# core.hooksPath points at .githooks, which disables any machine-wide hooks.
# Refuse ignored paths staged with "git add -f" so private notes stay local,
# then chain to the global pre-commit hook when one is configured.

forced=$(git diff --cached --name-only --diff-filter=ACMR -z | git check-ignore --no-index -z --stdin | tr '\0' '\n')
if [ -n "$forced" ]; then
  echo "pre-commit: refusing ignored paths staged with -f:" >&2
  echo "$forced" >&2
  exit 1
fi

# A global hook may call this repository hook back once it is done; the marker
# ends the chain there instead of handing over to the global hook again.
[ -n "$INTERLOCK_HOOK_CHAINED" ] && exit 0

global_dir=$(git config --global --get core.hooksPath)
[ -n "$global_dir" ] || exit 0
global_hook="$global_dir/pre-commit"
[ -f "$global_hook" ] || exit 0
[ "$(cd "$global_dir" 2>/dev/null && pwd)" = "$(cd .githooks && pwd)" ] && exit 0
INTERLOCK_HOOK_CHAINED=1 exec "$global_hook" "$@"
